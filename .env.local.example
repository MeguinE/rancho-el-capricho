# Copia este archivo como .env.local y rellena con los datos de tu proyecto Supabase.
# En Vercel: Project Settings → Environment Variables (pon las mismas).

# ── Supabase → Project Settings → API ──────────────────────────────
# Públicas (se usan en el navegador):
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Secreta (SOLO servidor, NUNCA la expongas ni la subas a git):
# Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# ── Panel de administración (/admin) ───────────────────────────────
# Contraseña con la que entras al panel:
ADMIN_PASSWORD=cambia-esta-contraseña
# Cadena larga y aleatoria para firmar la sesión (genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" ):
ADMIN_SESSION_SECRET=pon-aqui-una-cadena-larga-y-aleatoria
